# GEMINI_API_KEY: Required for Gemini AI API calls (Optional).
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="http://localhost:3000"

# DATABASE CONFIGURATION (PostgreSQL)
# For local VS Code setup:
SQL_HOST="localhost"
SQL_PORT="5432"
SQL_DB_NAME="modern_school"
SQL_USER="postgres"
SQL_PASSWORD="your_postgres_password"
SQL_ADMIN_USER="postgres"
SQL_ADMIN_PASSWORD="your_postgres_password"

# INITIAL ADMIN SETUP (Optional for automatic initialization)
INITIAL_ADMIN_EMAIL="dharuvattri@gmail.com"
INITIAL_ADMIN_PASSWORD="replace-with-a-unique-strong-password"
ADMIN_BOOTSTRAP_TOKEN="replace-with-a-unique-random-token"
